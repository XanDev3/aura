# ─────────────────────────────────────────────
# AURA Agent — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git
# ─────────────────────────────────────────────

# ── Agent Wallet (Base Mainnet) ───────────────
# The agent's private key — kept ONLY in Railway/Vercel env vars, never in code
AGENT_PRIVATE_KEY=0x...
AGENT_WALLET_ADDRESS=0x...

# ── Test Buyer Wallet (x402 test only — NOT the agent wallet) ─────────────
# A SEPARATE wallet used as the paying "client" in test-x402-client.ts.
# CRITICAL: Must be a different address from AGENT_WALLET_ADDRESS.
#   CDP rejects self-payment (from === to) with invalid_payload.
# How to set up:
#   1. Generate a new private key (e.g. cast wallet new, or use any keygen tool)
#   2. Fund it with a small amount of USDC on Base mainnet (0.05 USDC is enough for several tests)
#   3. Set the key and address below
TEST_BUYER_PRIVATE_KEY=0x...
TEST_BUYER_ADDRESS=0x...

# Base RPC (use Alchemy, Infura, or Coinbase's Base RPC)
BASE_RPC_URL=https://mainnet.base.org

# ── ERC-8021 Builder Code ─────────────────────
# Register at https://base.dev → Settings → Builder Codes
# Required for all Base mainnet transactions (bounty requirement)
ERC8021_BUILDER_CODE=your_code_here

# ── AI Model ─────────────────────────────────
# Primary inference: Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Model for routine agent ticks (cheap): claude-haiku-4-5
AGENT_TICK_MODEL=claude-haiku-4-5
# Model for x402 analysis service (quality): claude-sonnet-4-5
AGENT_ANALYSIS_MODEL=claude-sonnet-4-5

# ── x402 Payments (Coinbase) ────────────────
# CDP API credentials — required for mainnet x402 facilitator
# Register at https://cdp.coinbase.com → get API key
CDP_API_KEY_ID=your_cdp_key_id
CDP_API_KEY_SECRET=your_cdp_key_secret
# Facilitator URL for Base mainnet
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# ── 0G Labs (DeFAI Bounty) ────────────────────
# Sign up at https://build.0g.ai — needed for decentralized decision logging
# Get testnet tokens at faucet.0g.ai
ZG_PRIVATE_KEY=0x...          # Can reuse AGENT_PRIVATE_KEY or use separate wallet
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# ── Vercel KV (Shared State Store) ───────────
# Create at: Vercel Dashboard → Storage → KV → Create
# These are auto-populated when linked via Vercel CLI
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
KV_REST_API_READ_ONLY_TOKEN=...
REDIS_URL=redis://...

# ── Seed Capital Config ───────────────────────
# Safety floor: agent will never let total USDC drop below this
MIN_USDC_RESERVE=25
# Minimum liquid balance before depositing to Aave
AAVE_DEPOSIT_THRESHOLD=35
# Max % of liquid balance to deposit in a single tx
AAVE_MAX_DEPOSIT_PCT=80

# ── Agent Loop Config ─────────────────────────
# How often the agent ticks (in minutes). Default: 5
AGENT_INTERVAL_MINUTES=5
# Max tool-calling steps per Claude invocation
AGENT_MAX_STEPS=5

# ── Test Script ───────────────────────────────
# Used by: npm run test:x402
# Set to your deployed Vercel URL (e.g. https://aura-agent.vercel.app)
VERCEL_URL=https://your-project.vercel.app


